# ===== Railway service variables (set these in Railway -> service -> Variables) =====
# REQUIRED
CPANEL_API_URL=https://radhewins.buzz
SERVICE_SECRET=PASTE_THE_SAME_64_CHAR_SECRET_AS_IN_cPanel_finpulse_config.php
# Railway sets PORT itself. Mount a Railway Volume at /data.
DATA_DIR=/data

# OPTIONAL
# SBI_TARGET_NUMBER=919022690226       # fallback label only; the per-user target lives in cPanel (admin controlled)
# SCHEDULER_TICK_MS=15000
# MAX_CONCURRENT_CYCLES=2
# CYCLE_TIMEOUT_MS=120000
# MENU_TIMEOUT_MS=45000
# RUN_NOW_MIN_GAP_MS=60000
# LOG_LEVEL=info
